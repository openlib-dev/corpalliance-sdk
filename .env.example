# API credentials issued by Corporate Alliance's Integration Support team,
# per environment. Sandbox and Production pairs are not interchangeable.
#
# Quote values with SINGLE quotes: names carry spaces and keys may carry
# characters a shell would otherwise interpret.
CA_API_USER=''
CA_API_KEY=''

# Optional: your clientId, as printed by the SDK's Client.ClientID(). Not
# needed for API calls (omit clientId to act as yourself); useful for asserting
# at start-up that a deployment is pointed at the right account.
CA_CLIENT_ID=''
CA_CLIENT_NAME=''

# The API secret used to decrypt webhook payloads (AES-256-CBC). Only needed
# if you receive webhooks.
CA_API_SECRET=''
